# Application
ENVIRONMENT=development
APP_NAME=Diagnosis_Xpo API

# Database / cache
DATABASE_URL=postgresql://diagnosis:change-me@localhost:5432/diagnosis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Browser access
CORS_ORIGINS=http://localhost:3000

# Market data providers - add credentials when integrations are enabled
EOD_PRIMARY_PROVIDER=nse
EOD_SECONDARY_PROVIDER=bse
LIVE_MARKET_PROVIDER=
LIVE_MARKET_API_KEY=
FO_PROVIDER=nse
FO_API_KEY=

# AI provider - credentials must never be committed
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
